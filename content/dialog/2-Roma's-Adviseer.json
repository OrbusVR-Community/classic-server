        "tree": {
            "0": {
                "emotion": "greeting",
                "text": "Ah, the noble and pious $NAME, most favored soldier of the Holy Enforcers, how lovely to see you. I am, of course, Guïayne, Bishop Roma’s most trusted Advisor.",
                "choices": {
                    "0": {
                        "text": "Why are you here?",
                        "tree": {
                            "0": {
                                "emotion": "explain",
                                "text": "You may be wondering where your Commander, Petra Fassith is, as she would normally be delivering missions to you and other Enforcers around here, about now, would she not?",
                                "choices": {
                                    "0": {
                                        "text": "Do you know where she is?",
                                        "tree": {
                                            "0": {
                                                "emotion": "explain",
                                                "text": "Alas, I do not. Well, not exactly. I suspect she’s in hiding at this moment, for it would seem that while you’ve been off, a plot has unraveled!!"
                                            },
                                            "1": {
                                                "text": "Fassith had been scheming  with General Clavacius to overthrow Bishop Roma and reinstate the old High Bishop Archibald."
                                            },
                                            "2": {
